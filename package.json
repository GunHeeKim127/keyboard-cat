{
  "name": "keyboard-cat",
  "version": "1.2.1",
  "private": true,
  "description": "Privacy-first Windows keyboard companion",
  "author": "Keyboard Cat",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/atlas.cjs && node scripts/native.cjs && tsc -p tsconfig.electron.json && tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "test": "node --test tests/*.test.cjs",
    "sprites": "node scripts/sprites.cjs && node scripts/atlas.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "local.keyboardcat.pet",
    "productName": "Keyboard Cat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "native/KeyCounter.exe",
        "to": "KeyCounter.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
