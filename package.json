{
  "name": "keyboard-cat",
  "version": "2.5.2",
  "private": true,
  "description": "Privacy-first Windows and macOS keyboard companion",
  "author": "Keyboard Cat",
  "main": "dist-electron/bootstrap.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/interaction-assets.cjs && node scripts/penguin-sprites.cjs && node scripts/parrot-sprites.cjs && node scripts/monkey-sprites.cjs && node scripts/native.cjs && tsc -p tsconfig.electron.json && tsc --noEmit && vite build && node scripts/prune-runtime-sprites.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable --publish never && node scripts/clean-old-releases.cjs win",
    "test": "node --test tests/*.test.cjs",
    "sprites": "node scripts/sprites.cjs && node scripts/extra-sprites.cjs && node scripts/atlas.cjs && node scripts/dog-sprites.cjs && node scripts/cat-sprites.cjs && node scripts/parrot-sprites.cjs && node scripts/monkey-sprites.cjs && node scripts/penguin-sprites.cjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never && node scripts/clean-old-releases.cjs win",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never && node scripts/clean-old-releases.cjs mac",
    "postinstall": "node scripts/build-tool-compat.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "42.11.16",
    "electron-builder": "26.18.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "6.4.5"
  },
  "build": {
    "appId": "local.keyboardcat.pet",
    "productName": "Keyboard Cat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "native/KeyCounter.exe",
          "to": "KeyCounter.exe"
        },
        {
          "from": "native/DesktopScene.exe",
          "to": "DesktopScene.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "artifactName": "Keyboard-Cat-${version}-setup.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Keyboard-Cat-${version}-mac-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraFiles": [
        {
          "from": "native/KeyCounter-mac",
          "to": "MacOS/KeyCounter-mac"
        },
        {
          "from": "native/DesktopScene-mac",
          "to": "MacOS/DesktopScene-mac"
        }
      ],
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "바탕화면 최상위 아이콘을 발판으로 이동하고 폴더 출입을 표시하기 위해 이름과 위치만 확인합니다. 파일 내용은 읽거나 변경하지 않습니다."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GunHeeKim127",
        "repo": "keyboard-cat",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Keyboard-Cat-${version}-portable.exe"
    },
    "afterAllArtifactBuild": "scripts/core-artifacts.cjs",
    "extraResources": [
      {
        "from": "build/core-host.json",
        "to": "core-host.json"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "minimatch": "11.0.1",
    "@electron/asar": "4.3.1",
    "glob": "14.0.2"
  }
}
